# Normalize EOL for text
* text=auto eol=lf

# Godot scripts / resources as text
*.gd text eol=lf
*.cs text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.godot text eol=lf
*.cfg text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.import text eol=lf
*.uid text eol=lf

# Git LFS — large binaries (requires: git lfs install)
*.png filter=lfs diff=lfs merge=lfs -text
