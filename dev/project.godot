; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="ClaybornIdleUIDev"
config/tags=PackedStringArray("claybornidle")
run/main_scene="res://ui/features/combat/views/scenes/combat_hud_preview.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

UiRules="*res://ui/singleton/ui_rules.gd"
ThemeUpdater="*res://ui/singleton/theme_updater.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/aspect="ignore"

[editor_plugins]

enabled=PackedStringArray("res://addons/radial_progress/plugin.cfg")

[file_customization]

folder_colors={
"res://assets/": "yellow",
"res://ui/dev/": "red",
"res://ui/features/": "orange",
"res://ui/singleton/": "teal"
}

[godot_resource_groups]

auto_rebuild=true
